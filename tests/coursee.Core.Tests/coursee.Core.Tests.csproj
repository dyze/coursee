<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Coursee.Core.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- Coverage of Core, enforced on every `dotnet test` (coverlet.msbuild). -->
  <PropertyGroup>
    <CollectCoverage>true</CollectCoverage>
    <Include>[coursee.Core]*</Include>
    <Threshold>95</Threshold>
    <ThresholdType>line</ThresholdType>
    <CoverletOutputFormat>cobertura</CoverletOutputFormat>
    <CoverletOutput>$(ArtifactsPath)/coverage/</CoverletOutput>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.msbuild" Version="10.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- The tests cover all of Core, so every Core namespace is imported once here. -->
    <Using Include="Coursee.Core" />
    <Using Include="Coursee.Core.Entries" />
    <Using Include="Coursee.Core.Logging" />
    <Using Include="Coursee.Core.Placement" />
    <Using Include="Coursee.Core.Platform" />
    <Using Include="Coursee.Core.Recents" />
    <Using Include="Coursee.Core.Resources" />
    <Using Include="Coursee.Core.Search" />
    <Using Include="Coursee.Core.Settings" />
    <Using Include="Coursee.Core.Sources" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\coursee.Core\coursee.Core.csproj" />
  </ItemGroup>

</Project>
