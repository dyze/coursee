<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (System.Windows.Forms.NotifyIcon): WPF has no notification-area control. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>coursee.ico</ApplicationIcon>
    <RootNamespace>Coursee.UI</RootNamespace>
    <AssemblyName>coursee</AssemblyName>
  </PropertyGroup>

  <!-- The WPF SDK leaves System.IO out of the implicit usings (System.Windows.Shapes.Path would clash); this project needs it. -->
  <ItemGroup>
    <Using Include="System.IO" />
    <!-- Keep WinForms out of the global usings, or Application, MessageBox, KeyEventArgs... become ambiguous. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded so the tray and the log window can load it. -->
    <Resource Include="coursee.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\coursee.Core\coursee.Core.csproj" />
  </ItemGroup>

</Project>
