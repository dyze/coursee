<Window x:Class="Coursee.UI.Views.ChangelogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="coursee changelog"
        Icon="/Assets/coursee.ico"
        Width="760" Height="560"
        MinWidth="420" MinHeight="300"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <!-- CHANGELOG.md as plain text, read only but selectable. Esc or Close closes it. -->
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBox x:Name="ChangelogBox"
             IsReadOnly="True"
             TextWrapping="Wrap"
             VerticalScrollBarVisibility="Auto"
             FontFamily="Consolas"
             AutomationProperties.Name="Changelog" />

    <Button Grid.Row="1"
            Margin="0,12,0,0"
            MinWidth="90"
            Padding="12,4"
            HorizontalAlignment="Right"
            Content="Close"
            IsCancel="True" />
  </Grid>
</Window>
