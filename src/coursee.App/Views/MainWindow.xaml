<Window x:Class="Coursee.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Coursee.UI.Views"
        Title="coursee"
        Width="640" Height="520"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        KeyboardNavigation.TabNavigation="Cycle"
        Deactivated="Window_Deactivated"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="VisibleWhen" />

    <!-- The icons at the right of the action icon. They never take the focus (it stays in the search box),
         and are hidden, not collapsed, when they do not apply, so the action icons stay aligned. -->
    <Style x:Key="RowIconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Margin" Value="2,0,0,0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Visibility" Value="Hidden" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- The pin, alias and hide icons: shown on the selected row, and on the row under the mouse. The last
         matching trigger wins, so a disabled icon (typed text) stays hidden. -->
    <Style x:Key="RevealedRowIconButton" TargetType="Button" BasedOn="{StaticResource RowIconButton}">
      <Setter Property="Visibility" Value="Hidden" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Visibility" Value="Hidden" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- The pin icon of a pinned entry is always shown, so pinned rows can be told apart. -->
    <Style x:Key="PinButton" TargetType="Button" BasedOn="{StaticResource RevealedRowIconButton}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsPinned}" Value="True">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Likewise, the alias icon of an entry with an alias is always shown. -->
    <Style x:Key="AliasButton" TargetType="Button" BasedOn="{StaticResource RevealedRowIconButton}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding HasAlias}" Value="True">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBox x:Name="SearchBox"
               FontSize="20"
               Padding="8"
               TextChanged="SearchBox_TextChanged" />

      <!-- The settings icon. No padding: the Fluent theme's default one leaves too little room and cuts it.
           Tab moves the focus between the search box and this button only; Enter or Space opens Settings. -->
      <!-- Shown while the search box has text: makes that text a custom entry (Ctrl+N). Not a Tab stop. -->
      <Button x:Name="AddButton"
              Grid.Column="1"
              Width="48"
              Margin="8,0,0,0"
              Padding="0"
              VerticalAlignment="Stretch"
              Focusable="False"
              Visibility="Collapsed"
              ToolTip="Make the typed text a custom entry (Ctrl+N)"
              Click="AddButton_Click">
        <views:EntryIconView Size="20" IconName="add" />
      </Button>

      <Button x:Name="SettingsButton"
              Grid.Column="2"
              Width="48"
              Margin="8,0,0,0"
              Padding="0"
              VerticalAlignment="Stretch"
              ToolTip="Settings (Tab, then Enter)"
              Click="SettingsButton_Click">
        <views:EntryIconView Size="20" IconName="settings" />
      </Button>

      <!-- A newer release is available (see Settings > About). Over the button's corner; clicks go through. -->
      <Ellipse x:Name="UpdateMark"
               Grid.Column="2"
               Width="9"
               Height="9"
               Margin="0,7,7,0"
               HorizontalAlignment="Right"
               VerticalAlignment="Top"
               Fill="{DynamicResource SystemFillColorCautionBrush}"
               IsHitTestVisible="False"
               Visibility="Collapsed" />
    </Grid>

    <!-- Two lines under the search box: what Enter does, then the other keys. The second one keeps
         its height when empty, so the list does not move. -->
    <TextBlock x:Name="ActionText"
               Grid.Row="1"
               Margin="4,6,0,0"
               FontSize="12"
               Opacity="0.7"
               TextTrimming="CharacterEllipsis" />

    <TextBlock x:Name="KeysText"
               Grid.Row="2"
               Margin="4,2,0,0"
               FontSize="12"
               Opacity="0.7"
               TextTrimming="CharacterEllipsis" />

    <ListBox x:Name="ResultsList"
             Grid.Row="3"
             Margin="0,6,0,0"
             HorizontalContentAlignment="Stretch"
             IsTabStop="False"
             KeyboardNavigation.TabNavigation="None"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             MouseDoubleClick="ResultsList_MouseDoubleClick"
             SelectionChanged="ResultsList_SelectionChanged">
      <!-- Compact rows: the theme's are sized for touch. -->
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
          <Setter Property="MinHeight" Value="0" />
          <Setter Property="Padding" Value="8,2" />
        </Style>
      </ListBox.ItemContainerStyle>
      <!-- Rows are as wide as the list (no horizontal scroll): a long name or target is cut with "…",
           so the action column on the right always shows. -->
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid Margin="4,2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- The entry's icon (chosen with Ctrl+I, else its own), or where the item comes from (the same icon
                 as in Settings > Sources). The source's name is the tooltip either way. Its converter is added by
                 the window, from the list of sources. -->
            <Grid Width="32"
                  Margin="0,0,10,0"
                  VerticalAlignment="Center"
                  Background="Transparent"
                  ToolTip="{Binding Resource.Source, Converter={StaticResource SourceIcon}, ConverterParameter=Label}">
              <views:EntryIconView Size="24"
                                   HorizontalAlignment="Center"
                                   Opacity="0.6"
                                   IconName="{Binding Resource.Source, Converter={StaticResource SourceIcon}}"
                                   Visibility="{Binding HasNoIcon, Converter={StaticResource VisibleWhen}}" />
              <views:EntryIconView Size="32" HorizontalAlignment="Center" Visual="{Binding Icon}" />
            </Grid>

            <StackPanel Grid.Column="1">
              <TextBlock Text="{Binding Resource.Name}" FontSize="15" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Resource.Target}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- The row's box, for its alias (F2) or the name of a new custom entry (Ctrl+N): Enter saves,
                 Esc or leaving it cancels. Filled and focused by the window. -->
            <TextBox Grid.Column="2"
                     Width="160"
                     Margin="8,0,0,0"
                     VerticalAlignment="Center"
                     FontSize="13"
                     MaxLength="{Binding EditMaxLength}"
                     ToolTip="{Binding EditToolTip}"
                     Visibility="{Binding IsEditing, Converter={StaticResource VisibleWhen}}"
                     LostKeyboardFocus="EditBox_LostKeyboardFocus" />

            <!-- What Enter does, as an icon on every row; its wording is the tooltip (and the first line under
                 the search box). Clicking it does the same as Enter on that row. -->
            <Button Grid.Column="3"
                    Margin="10,0,2,0"
                    Style="{StaticResource RowIconButton}"
                    Opacity="0.7"
                    ToolTip="{Binding Resource.ActionLabel}"
                    Click="ActionButton_Click">
              <views:EntryIconView Size="16" IconName="{Binding ActionIcon}" />
            </Button>

            <StackPanel Grid.Column="4" Orientation="Horizontal">
              <Button Style="{StaticResource PinButton}"
                      IsEnabled="{Binding CanPin}"
                      ToolTip="{Binding PinToolTip}"
                      Click="PinButton_Click">
                <views:EntryIconView Size="15" IconName="{Binding PinIcon}" />
              </Button>
              <Button Style="{StaticResource AliasButton}"
                      IsEnabled="{Binding CanSetAlias}"
                      ToolTip="{Binding AliasToolTip}"
                      Click="AliasButton_Click">
                <views:EntryIconView Size="15" IconName="{Binding AliasIcon}" />
              </Button>
              <Button Style="{StaticResource RevealedRowIconButton}"
                      IsEnabled="{Binding CanHide}"
                      ToolTip="Hide from results and recents (Ctrl+H). Restore it in Settings > Entries"
                      Click="HideButton_Click">
                <views:EntryIconView Size="15" IconName="eye-off" />
              </Button>
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <TextBlock x:Name="VersionText"
               Grid.Row="4"
               Margin="0,6,0,0"
               HorizontalAlignment="Right"
               FontSize="10"
               Opacity="0.5" />
  </Grid>
</Window>
