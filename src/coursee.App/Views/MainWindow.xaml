<Window x:Class="Coursee.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Coursee.UI.Views"
        Title="coursee"
        Width="640" Height="520"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Deactivated="Window_Deactivated"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Window.Resources>
    <views:ActionGlyphConverter x:Key="ActionGlyph" />
  </Window.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBox x:Name="SearchBox"
               FontSize="20"
               Padding="8"
               TextChanged="SearchBox_TextChanged" />

      <!-- The Windows settings icon. No padding: the Fluent theme's default one leaves too little room and cuts it. -->
      <Button x:Name="SettingsButton"
              Grid.Column="1"
              Width="48"
              Margin="8,0,0,0"
              Padding="0"
              VerticalAlignment="Stretch"
              Content="&#xE713;"
              FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
              FontSize="18"
              ToolTip="Settings"
              Focusable="False"
              Click="SettingsButton_Click" />
    </Grid>

    <TextBlock x:Name="ActionText"
               Grid.Row="1"
               Margin="4,6,0,0"
               FontSize="12"
               Opacity="0.7" />

    <ListBox x:Name="ResultsList"
             Grid.Row="2"
             Margin="0,6,0,0"
             HorizontalContentAlignment="Stretch"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             MouseDoubleClick="ResultsList_MouseDoubleClick"
             SelectionChanged="ResultsList_SelectionChanged">
      <!-- Rows are as wide as the list (no horizontal scroll): a long name or target is cut with "…",
           so the action column on the right always shows. -->
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid Margin="4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Where the item comes from (the same icon as in Settings > Sources). Its converter is
                 added by the window, from the list of sources. -->
            <TextBlock Width="18"
                       Margin="0,0,10,0"
                       VerticalAlignment="Center"
                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="14"
                       Opacity="0.6"
                       Text="{Binding Source, Converter={StaticResource SourceIcon}}"
                       ToolTip="{Binding Source, Converter={StaticResource SourceIcon}, ConverterParameter=Label}" />

            <StackPanel Grid.Column="1">
              <TextBlock Text="{Binding Name}" FontSize="15" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Target}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <!-- What Enter does, as an icon; its wording is the tooltip (and the line under the search box). -->
            <TextBlock Grid.Column="2"
                       Margin="12,0,4,0"
                       VerticalAlignment="Center"
                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="16"
                       Opacity="0.7"
                       Text="{Binding Action, Converter={StaticResource ActionGlyph}}"
                       ToolTip="{Binding ActionLabel}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <TextBlock x:Name="VersionText"
               Grid.Row="3"
               Margin="0,6,0,0"
               HorizontalAlignment="Right"
               FontSize="10"
               Opacity="0.5" />
  </Grid>
</Window>
