<Window x:Class="Coursee.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Coursee.UI.Views"
        Title="coursee"
        Width="640" Height="520"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        KeyboardNavigation.TabNavigation="Cycle"
        Deactivated="Window_Deactivated"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Window.Resources>
    <views:ActionGlyphConverter x:Key="ActionGlyph" />
    <BooleanToVisibilityConverter x:Key="VisibleWhen" />

    <!-- The icons at the right of the action icon. They never take the focus (it stays in the search box),
         and are hidden, not collapsed, when they do not apply, so the action icons stay aligned. -->
    <Style x:Key="RowIconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Margin" Value="2,0,0,0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="14" />
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Visibility" Value="Hidden" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Shown on the selected row only. -->
    <Style x:Key="SelectedRowOnly" TargetType="StackPanel">
      <Setter Property="Visibility" Value="Hidden" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBox x:Name="SearchBox"
               FontSize="20"
               Padding="8"
               TextChanged="SearchBox_TextChanged" />

      <!-- The Windows settings icon. No padding: the Fluent theme's default one leaves too little room and cuts it.
           Tab moves the focus between the search box and this button only; Enter or Space opens Settings. -->
      <Button x:Name="SettingsButton"
              Grid.Column="1"
              Width="48"
              Margin="8,0,0,0"
              Padding="0"
              VerticalAlignment="Stretch"
              Content="&#xE713;"
              FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
              FontSize="18"
              ToolTip="Settings (Tab, then Enter)"
              Click="SettingsButton_Click" />
    </Grid>

    <!-- Two lines under the search box: what Enter does, then the other keys. The second one keeps
         its height when empty, so the list does not move. -->
    <TextBlock x:Name="ActionText"
               Grid.Row="1"
               Margin="4,6,0,0"
               FontSize="12"
               Opacity="0.7"
               TextTrimming="CharacterEllipsis" />

    <TextBlock x:Name="KeysText"
               Grid.Row="2"
               Margin="4,2,0,0"
               FontSize="12"
               Opacity="0.7"
               TextTrimming="CharacterEllipsis" />

    <ListBox x:Name="ResultsList"
             Grid.Row="3"
             Margin="0,6,0,0"
             HorizontalContentAlignment="Stretch"
             IsTabStop="False"
             KeyboardNavigation.TabNavigation="None"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             MouseDoubleClick="ResultsList_MouseDoubleClick"
             SelectionChanged="ResultsList_SelectionChanged">
      <!-- Rows are as wide as the list (no horizontal scroll): a long name or target is cut with "…",
           so the action column on the right always shows. -->
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid Margin="4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Where the item comes from (the same icon as in Settings > Sources). Its converter is
                 added by the window, from the list of sources. -->
            <TextBlock Width="18"
                       Margin="0,0,10,0"
                       VerticalAlignment="Center"
                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="14"
                       Opacity="0.6"
                       Text="{Binding Resource.Source, Converter={StaticResource SourceIcon}}"
                       ToolTip="{Binding Resource.Source, Converter={StaticResource SourceIcon}, ConverterParameter=Label}" />

            <StackPanel Grid.Column="1">
              <TextBlock Text="{Binding Resource.Name}" FontSize="15" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Resource.Target}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- The alias box (F2): Enter saves, Esc or leaving it cancels. Filled and focused by the window. -->
            <TextBox Grid.Column="2"
                     Width="120"
                     Margin="8,0,0,0"
                     VerticalAlignment="Center"
                     FontSize="13"
                     MaxLength="40"
                     ToolTip="Alias: Enter saves, Esc cancels, empty removes it"
                     Visibility="{Binding IsEditingAlias, Converter={StaticResource VisibleWhen}}"
                     LostKeyboardFocus="AliasBox_LostKeyboardFocus" />

            <!-- What Enter does, as an icon; its wording is the tooltip (and the line under the search box). -->
            <TextBlock Grid.Column="3"
                       Margin="12,0,4,0"
                       VerticalAlignment="Center"
                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="16"
                       Opacity="0.7"
                       Text="{Binding Resource.Action, Converter={StaticResource ActionGlyph}}"
                       ToolTip="{Binding Resource.ActionLabel}" />

            <StackPanel Grid.Column="4" Orientation="Horizontal" Style="{StaticResource SelectedRowOnly}">
              <Button Style="{StaticResource RowIconButton}"
                      Content="{Binding PinGlyph}"
                      IsEnabled="{Binding CanPin}"
                      ToolTip="{Binding PinToolTip}"
                      Click="PinButton_Click" />
              <Button Style="{StaticResource RowIconButton}"
                      Content="&#xE8EC;"
                      IsEnabled="{Binding CanSetAlias}"
                      ToolTip="{Binding AliasToolTip}"
                      Click="AliasButton_Click" />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <TextBlock x:Name="VersionText"
               Grid.Row="4"
               Margin="0,6,0,0"
               HorizontalAlignment="Right"
               FontSize="10"
               Opacity="0.5" />
  </Grid>
</Window>
