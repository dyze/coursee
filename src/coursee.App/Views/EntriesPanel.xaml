<UserControl x:Class="Coursee.UI.Views.EntriesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="GroupHeader" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,14,0,4" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="EmptyText" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,2,0,0" />
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="DetailText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="Padding" Value="10,2" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="RowBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Resources>

  <!-- Each list is rebuilt after a change. Enter in a box saves its row. -->
  <StackPanel>
    <TextBlock Text="Hidden entries" Style="{StaticResource GroupHeader}" />
    <TextBlock x:Name="NoHiddenText" Style="{StaticResource EmptyText}" Text="None. Ctrl+H in the launcher hides the selected entry." />
    <ItemsControl x:Name="HiddenList" Focusable="False">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Detail}" Style="{StaticResource DetailText}" />
            </StackPanel>
            <Button Grid.Column="1" Content="Restore" Style="{StaticResource RowButton}" Click="RestoreButton_Click" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock Text="Custom entries" Style="{StaticResource GroupHeader}" />
    <TextBlock x:Name="NoCustomText" Style="{StaticResource EmptyText}" Text="None. Ctrl+N or + in the launcher makes the typed text one." />
    <ItemsControl x:Name="CustomList" Focusable="False">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" />
              <ColumnDefinition Width="3*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource RowBox}"
                     MaxLength="100"
                     ToolTip="Name"
                     KeyDown="CustomBox_KeyDown" />
            <TextBox Grid.Column="1"
                     Margin="6,0,0,0"
                     Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource RowBox}"
                     ToolTip="Target: a URL, folder, file or command"
                     KeyDown="CustomBox_KeyDown" />
            <Button Grid.Column="2" Content="Save" Style="{StaticResource RowButton}" Click="SaveCustomButton_Click" />
            <Button Grid.Column="3" Content="Delete" Style="{StaticResource RowButton}" Click="DeleteCustomButton_Click" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock Text="Aliases" Style="{StaticResource GroupHeader}" />
    <TextBlock x:Name="NoAliasesText" Style="{StaticResource EmptyText}" Text="None. F2 in the launcher gives the selected entry an alias." />
    <ItemsControl x:Name="AliasList" Focusable="False">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="120" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding Alias, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource RowBox}"
                     MaxLength="40"
                     ToolTip="Alias: empty removes it"
                     KeyDown="AliasBox_KeyDown" />
            <TextBlock Grid.Column="1"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       Text="{Binding Target}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Target}" />
            <Button Grid.Column="2" Content="Save" Style="{StaticResource RowButton}" Click="SaveAliasButton_Click" />
            <Button Grid.Column="3" Content="Remove" Style="{StaticResource RowButton}" Click="RemoveAliasButton_Click" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock Text="Pins" Style="{StaticResource GroupHeader}" />
    <TextBlock x:Name="NoPinsText" Style="{StaticResource EmptyText}" Text="None. Ctrl+P in the launcher pins the selected entry." />
    <ItemsControl x:Name="PinList" Focusable="False">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" />
            <Button Grid.Column="1" Content="Unpin" Style="{StaticResource RowButton}" Click="UnpinButton_Click" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
