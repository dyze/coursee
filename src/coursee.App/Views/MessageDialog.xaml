<Window x:Class="Coursee.UI.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="coursee"
        Icon="/Assets/coursee.ico"
        MinWidth="320" MaxWidth="520"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        SourceInitialized="Window_SourceInitialized">
  <!-- A message box in the app's theme (the Windows one ignores it). Enter: the default button, Esc: the cancel one. -->
  <Grid Margin="20,18,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock x:Name="MessageText" TextWrapping="Wrap" />

    <StackPanel Grid.Row="1"
                Margin="0,20,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
      <Button x:Name="YesButton"
              MinWidth="90"
              Padding="12,4"
              IsDefault="True"
              Click="YesButton_Click" />
      <Button x:Name="NoButton"
              MinWidth="90"
              Margin="8,0,0,0"
              Padding="12,4"
              Content="No"
              IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
