<Window x:Class="Coursee.UI.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="coursee"
        Icon="/Assets/coursee.ico"
        MinWidth="320" MaxWidth="520"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        SourceInitialized="Window_SourceInitialized">
  <!-- A message box in the app's theme (the Windows one ignores it). Enter: the default button, Esc: the cancel one. -->
  <Grid Margin="20,18,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel>
      <!-- A notice shows a warning sign (Segoe Fluent "Warning"), in the theme's caution color. -->
      <TextBlock x:Name="WarningIcon"
                 DockPanel.Dock="Left"
                 Margin="0,0,14,0"
                 VerticalAlignment="Top"
                 FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                 FontSize="28"
                 Foreground="{DynamicResource SystemFillColorCautionBrush}"
                 Text="&#xE7BA;"
                 Visibility="Collapsed" />
      <TextBlock x:Name="MessageText" VerticalAlignment="Center" TextWrapping="Wrap" />
    </DockPanel>

    <!-- A notice can carry one option (MessageDialog.Notice). -->
    <CheckBox x:Name="OptionCheckBox"
              Grid.Row="1"
              Margin="0,16,0,0"
              Visibility="Collapsed" />

    <StackPanel Grid.Row="2"
                Margin="0,20,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
      <Button x:Name="YesButton"
              MinWidth="90"
              Padding="12,4"
              IsDefault="True"
              Click="YesButton_Click" />
      <Button x:Name="NoButton"
              MinWidth="90"
              Margin="8,0,0,0"
              Padding="12,4"
              Content="No"
              IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
