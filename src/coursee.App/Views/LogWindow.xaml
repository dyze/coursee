<Window x:Class="Coursee.UI.Views.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="coursee log"
        Icon="/Assets/coursee.ico"
        Width="900" Height="500"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal">
      <TextBlock Text="Level" VerticalAlignment="Center" />
      <ComboBox x:Name="LevelComboBox"
                Width="110"
                Margin="6,0,0,0"
                SelectionChanged="Filter_Changed" />
      <TextBlock Text="Filter" Margin="16,0,0,0" VerticalAlignment="Center" />
      <TextBox x:Name="FilterBox"
               Width="220"
               Margin="6,0,0,0"
               TextChanged="Filter_Changed" />
      <Button Content="Copy" Margin="16,0,0,0" Padding="12,2"
              ToolTip="Copy the selected lines, or all visible lines"
              Click="Copy_Click" />
      <Button Content="Open log folder" Margin="8,0,0,0" Padding="12,2" Click="OpenFolder_Click" />
      <Button Content="Clear" Margin="8,0,0,0" Padding="12,2"
              ToolTip="Clears this window only; the log files are kept"
              Click="Clear_Click" />
    </StackPanel>

    <ListView x:Name="EntriesList"
              Grid.Row="1"
              Margin="0,8,0,0"
              SelectionMode="Extended"
              FontFamily="Consolas"
              FontSize="12">
      <!-- Compact rows: the theme's are sized for touch. Based on the GridView row style, which lays out the columns. -->
      <ListView.ItemContainerStyle>
        <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
          <Setter Property="MinHeight" Value="0" />
          <Setter Property="Height" Value="20" />
          <Setter Property="Padding" Value="0" />
          <Setter Property="Margin" Value="0" />
        </Style>
      </ListView.ItemContainerStyle>
      <ListView.View>
        <GridView x:Name="LogColumns">
          <GridViewColumn Header="Time" Width="100" DisplayMemberBinding="{Binding TimeText}" />
          <GridViewColumn Header="Level" Width="64" DisplayMemberBinding="{Binding LevelText}" />
          <GridViewColumn Header="Category" Width="220" DisplayMemberBinding="{Binding Category}" />
          <GridViewColumn Header="Message" Width="600" DisplayMemberBinding="{Binding Message}" />
        </GridView>
      </ListView.View>
    </ListView>

    <TextBlock x:Name="StatusText"
               Grid.Row="2"
               Margin="0,6,0,0"
               FontSize="11"
               Opacity="0.6" />
  </Grid>
</Window>
