<Window x:Class="Coursee.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:settings="clr-namespace:Coursee.Core.Settings;assembly=coursee.Core"
        Title="coursee settings"
        Icon="/Assets/coursee.ico"
        Width="820" Height="500"
        MinWidth="800" MinHeight="420"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        SourceInitialized="Window_SourceInitialized"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Window.Resources>
    <Style x:Key="SectionHeader" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,16,0,0" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Shown when the hotkey could not be registered at start. Half-transparent, so it suits both themes. -->
    <Border x:Name="HotkeyBanner"
            Margin="0,0,0,12"
            Padding="10,8"
            BorderBrush="#E0A000"
            BorderThickness="1"
            CornerRadius="4"
            Background="#33FFB900"
            Visibility="Collapsed">
      <TextBlock x:Name="HotkeyBannerText" TextWrapping="Wrap" />
    </Border>

    <!-- While it has text, the tabs are replaced by the matching settings of every tab. -->
    <Grid Grid.Row="1">
      <TextBox x:Name="FindBox"
               Padding="6,4"
               ToolTip="Find a setting (Ctrl+F). Down goes to the first setting shown"
               TextChanged="FindBox_TextChanged"
               PreviewKeyDown="FindBox_PreviewKeyDown" />
      <TextBlock x:Name="FindPlaceholder"
                 Margin="10,0,0,0"
                 VerticalAlignment="Center"
                 IsHitTestVisible="False"
                 Opacity="0.5"
                 Text="Find a setting" />
    </Grid>

    <!-- The tabs: a horizontal list, so that the sections below can also be shown all at once.
         Tab enters it on the selected tab, Left / Right change tabs; Ctrl+Tab works from anywhere. -->
    <ListBox x:Name="TabList"
             Grid.Row="2"
             Margin="0,10,0,0"
             BorderThickness="0"
             Background="Transparent"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             SelectionChanged="TabList_SelectionChanged">
      <!-- Wraps when the window is too narrow for every tab. -->
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
          <Setter Property="Padding" Value="14,6" />
          <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
      </ListBox.ItemContainerStyle>
      <!-- The tab name; About gets a dot while a newer release exists (AboutMarked). -->
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding}" />
            <Ellipse x:Name="Mark"
                     Width="8"
                     Height="8"
                     Margin="6,0,0,0"
                     VerticalAlignment="Center"
                     Fill="{DynamicResource SystemFillColorCautionBrush}"
                     Visibility="Collapsed" />
          </StackPanel>
          <DataTemplate.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding}" Value="{x:Static settings:SettingsCatalog.AboutTab}" />
                <Condition Binding="{Binding AboutMarked, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
              </MultiDataTrigger.Conditions>
              <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
          </DataTemplate.Triggers>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- One panel per tab (its Tag). Rows carry the id of their setting (SettingsCatalog) in their Tag. -->
    <!-- Not a Tab stop itself: Tab goes from the tab strip straight to the first setting. -->
    <ScrollViewer x:Name="SectionsScroller"
                  Grid.Row="3"
                  Margin="0,8,0,0"
                  Focusable="False"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="SectionsPanel">
        <TextBlock x:Name="NoMatchText"
                   Margin="0,16,0,0"
                   Opacity="0.6"
                   Text="No setting matches."
                   Visibility="Collapsed" />

        <StackPanel Tag="{x:Static settings:SettingsCatalog.GeneralTab}">
          <TextBlock Text="{x:Static settings:SettingsCatalog.GeneralTab}" Style="{StaticResource SectionHeader}" />

          <StackPanel Tag="{x:Static settings:SettingsCatalog.RecentsCapacityId}"
                      Margin="0,10,0,0"
                      Orientation="Horizontal">
            <TextBlock Text="Recent items to keep" Width="150" VerticalAlignment="Center" />
            <ComboBox x:Name="RecentsComboBox"
                      Width="80"
                      SelectionChanged="RecentsComboBox_SelectionChanged" />
          </StackPanel>

          <StackPanel Tag="{x:Static settings:SettingsCatalog.LauncherPositionId}"
                      Margin="0,10,0,0"
                      Orientation="Horizontal">
            <TextBlock Text="Launcher position" Width="150" VerticalAlignment="Center" />
            <ComboBox x:Name="LauncherPositionComboBox"
                      Width="230"
                      SelectionChanged="LauncherPositionComboBox_SelectionChanged" />
          </StackPanel>

          <CheckBox x:Name="IgnoreAccentsCheckBox"
                    Tag="{x:Static settings:SettingsCatalog.IgnoreAccentsId}"
                    Margin="0,10,0,0"
                    Content="Ignore accents when searching"
                    ToolTip="On: &quot;parametres&quot; finds &quot;Paramètres&quot;"
                    Click="IgnoreAccentsCheckBox_Click" />

          <CheckBox x:Name="AllowTypedCommandsCheckBox"
                    Tag="{x:Static settings:SettingsCatalog.AllowTypedCommandsId}"
                    Margin="0,10,0,0"
                    Content="Run typed text as a command"
                    ToolTip="Like the Windows Run dialog (Win+R), with your rights. Off: typed URLs, folders and files still open"
                    Click="AllowTypedCommandsCheckBox_Click" />

          <StackPanel Tag="{x:Static settings:SettingsCatalog.AutoStartId}" Margin="0,10,0,0">
            <CheckBox x:Name="AutoStartCheckBox"
                      Content="Start coursee when I sign in to Windows"
                      Click="AutoStartCheckBox_Click" />
            <!-- Shown when Windows starts another copy (for example the installed one). -->
            <TextBlock x:Name="AutoStartNote"
                       Margin="28,4,0,0"
                       FontSize="11"
                       Opacity="0.7"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />
          </StackPanel>
        </StackPanel>

        <StackPanel Tag="{x:Static settings:SettingsCatalog.AppearanceTab}">
          <TextBlock Text="{x:Static settings:SettingsCatalog.AppearanceTab}" Style="{StaticResource SectionHeader}" />

          <StackPanel Tag="{x:Static settings:SettingsCatalog.ThemeId}"
                      Margin="0,10,0,0"
                      Orientation="Horizontal">
            <TextBlock Text="Theme" Width="150" VerticalAlignment="Center" />
            <ComboBox x:Name="ThemeComboBox"
                      Width="160"
                      SelectionChanged="ThemeComboBox_SelectionChanged" />
          </StackPanel>
        </StackPanel>

        <!-- Built from the list of sources (SettingsWindow.ShowSources): a checkbox each, then Add folder. -->
        <StackPanel x:Name="SourcesSection" Tag="{x:Static settings:SettingsCatalog.SourcesTab}">
          <TextBlock Text="{x:Static settings:SettingsCatalog.SourcesTab}" Style="{StaticResource SectionHeader}" />
        </StackPanel>

        <!-- In the search results only: the Entries tab itself is shown in EntriesHost. -->
        <StackPanel Tag="{x:Static settings:SettingsCatalog.EntriesTab}">
          <TextBlock Text="{x:Static settings:SettingsCatalog.EntriesTab}" Style="{StaticResource SectionHeader}" />

          <Button Tag="{x:Static settings:SettingsCatalog.EntriesId}"
                  Margin="0,10,0,0"
                  Padding="12,4"
                  HorizontalAlignment="Left"
                  Content="Hidden entries, custom entries, aliases and pins"
                  Click="ShowEntriesButton_Click" />
        </StackPanel>

        <StackPanel Tag="{x:Static settings:SettingsCatalog.KeysTab}">
          <TextBlock Text="{x:Static settings:SettingsCatalog.KeysTab}" Style="{StaticResource SectionHeader}" />

          <StackPanel Tag="{x:Static settings:SettingsCatalog.HotkeyId}"
                      Margin="0,10,0,0"
                      Orientation="Horizontal">
            <TextBlock Text="Hotkey" Width="150" VerticalAlignment="Center" />
            <TextBox x:Name="HotkeyText"
                     Width="230"
                     IsReadOnly="True"
                     Focusable="False" />
            <Button x:Name="HotkeyButton"
                    Margin="8,0,0,0"
                    Padding="12,4"
                    Content="Change"
                    Click="HotkeyButton_Click" />
          </StackPanel>

          <!-- Read only: the keys cannot be changed (yet). Grouped by where they work. -->
          <ItemsControl x:Name="KeyBindingsList"
                        Tag="{x:Static settings:SettingsCatalog.KeyBindingsId}"
                        Focusable="False">
            <ItemsControl.GroupStyle>
              <GroupStyle>
                <GroupStyle.HeaderTemplate>
                  <DataTemplate>
                    <TextBlock Margin="0,14,0,4" FontWeight="SemiBold" Text="{Binding Name}" />
                  </DataTemplate>
                </GroupStyle.HeaderTemplate>
              </GroupStyle>
            </ItemsControl.GroupStyle>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Keys}" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="1" Text="{Binding Action}" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Tag="{x:Static settings:SettingsCatalog.LoggingTab}">
          <TextBlock Text="{x:Static settings:SettingsCatalog.LoggingTab}" Style="{StaticResource SectionHeader}" />

          <CheckBox x:Name="DebugLoggingCheckBox"
                    Tag="{x:Static settings:SettingsCatalog.DebugLoggingId}"
                    Margin="0,10,0,0"
                    Content="Detailed (debug) logging"
                    Click="DebugLoggingCheckBox_Click" />

          <Button Tag="{x:Static settings:SettingsCatalog.LogWindowId}"
                  Margin="0,10,0,0"
                  Padding="12,4"
                  HorizontalAlignment="Left"
                  Content="Open log window"
                  Click="OpenLogButton_Click" />
        </StackPanel>

        <StackPanel Tag="{x:Static settings:SettingsCatalog.AboutTab}">
          <TextBlock Text="{x:Static settings:SettingsCatalog.AboutTab}" Style="{StaticResource SectionHeader}" />

          <StackPanel Tag="{x:Static settings:SettingsCatalog.AboutId}" Margin="0,10,0,0">
            <TextBlock x:Name="AboutVersionText" FontWeight="SemiBold" />
            <TextBlock Margin="0,8,0,0">
              <Hyperlink x:Name="RepositoryLink" Click="Link_Click">Website (GitHub)</Hyperlink>
              <Run Text="  ·  " />
              <Hyperlink x:Name="IssuesLink" Click="Link_Click">Report an issue</Hyperlink>
            </TextBlock>
          </StackPanel>

          <!-- What the last check found (filled by ShowUpdateStatus), and the switch. -->
          <StackPanel Tag="{x:Static settings:SettingsCatalog.UpdatesId}" Margin="0,16,0,0">
            <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap" />
            <CheckBox x:Name="CheckForUpdatesCheckBox"
                      Margin="0,8,0,0"
                      Content="Check for updates once a day"
                      ToolTip="Asks GitHub for the latest release: coursee's only network access. Nothing is downloaded"
                      Click="CheckForUpdatesCheckBox_Click" />
          </StackPanel>

          <!-- One row per file, built from AppFiles: name, path (selectable), Show in folder. -->
          <Grid x:Name="FilesGrid"
                Tag="{x:Static settings:SettingsCatalog.FilesId}"
                Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
          </Grid>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- The Entries tab fills the height, its list scrolling on its own: shown instead of the sections. -->
    <ContentControl x:Name="EntriesHost"
                    Grid.Row="3"
                    Margin="0,8,0,0"
                    Focusable="False"
                    Visibility="Collapsed" />

    <TextBlock Grid.Row="4"
               Margin="0,8,0,0"
               FontSize="11"
               Opacity="0.6"
               Text="Changes are saved at once. Ctrl+Tab changes tab. Esc closes this window." />
  </Grid>
</Window>
