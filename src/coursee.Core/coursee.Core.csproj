<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Coursee.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- The icons an entry can be given (IconLibrary), read by name. -->
    <EmbeddedResource Include="Icons\Svg\*.svg" LogicalName="icons/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
